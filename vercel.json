{
  "version": 2,
  "rewrites": [
    {
      "source": "/backend",
      "destination": "/__blocked_backend_source"
    },
    {
      "source": "/backend/(.*)",
      "destination": "/__blocked_backend_source"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
